# UniConnect backend environment
# Copy this file to .env and fill in local values.
# Never commit .env

ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string

# SQLAlchemy + psycopg (v3) connection string
# Local Docker Postgres (docker compose up -d) uses port 5434:
DATABASE_URL=postgresql+psycopg://uniconnect:uniconnect@127.0.0.1:5434/uniconnect
# Host PostgreSQL (after backend/scripts/create_local_db.sql) would use:
# DATABASE_URL=postgresql+psycopg://uniconnect:uniconnect@127.0.0.1:5432/uniconnect

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Transactional email — leave blank locally; required in production for signup emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=UniConnect <noreply@localhost>

# File storage — configure in a later phase
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Comma-separated emails that receive admin access on register/login
ADMIN_EMAILS=

# Vercel (two projects: frontend + API)
# ENVIRONMENT=production
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require
# FRONTEND_URL=https://your-app.vercel.app
# BACKEND_URL=https://your-api.vercel.app
# CORS_ORIGINS=https://your-app.vercel.app
